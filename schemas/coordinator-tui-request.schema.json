{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.dev/schemas/coordinator-tui-request-1.0.json",
  "title": "Coordinator to Agent Workflow TUI interaction request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "project_id", "ar", "interaction", "guidance_request", "session_id"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "coordinator-tui-request"},
    "project_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "ar": {
      "type": "object", "additionalProperties": false,
      "required": ["ar_id", "task_revision", "status", "description", "specification"],
      "properties": {
        "ar_id": {"type": "string", "pattern": "^AR-[0-9]{4}$"},
        "task_revision": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "specification": {"type": "object"}
      }
    },
    "interaction": {
      "type": "object", "additionalProperties": false,
      "required": ["interaction_required", "decision_request_ref", "decision_status", "trigger"],
      "properties": {
        "interaction_required": {"const": true},
        "decision_request_ref": {"type": "string", "pattern": "^AWG-"},
        "decision_status": {"enum": ["pending", "in_progress", "resolved", "superseded"]},
        "trigger": {"enum": ["clarification", "decision", "guidance", "mandatory-approval", "recovery"]},
        "decision_class": {"type": "string", "minLength": 1},
        "oracle_deadline": {"type": "string", "minLength": 1}
      }
    },
    "guidance_request": {"type": "object", "required": ["schema_version", "request_id", "context", "formal_check", "candidates"]}
  }
}
